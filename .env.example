# ── Jev (TypeSafe System One) ─────────────────────────────────────────
# Official API: POST https://api.typesafe.ai/v1/systemone
# With a key, Jev Studio uses the real model; without one it falls back to
# a clearly-labelled simulation (MockJevProvider).
TYPESAFE_API_KEY=
# JEV_API_KEY=

# ── LLM (OpenAI-compatible: OpenAI, llama.cpp server, vLLM, LM Studio…) ──
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8080/v1

# ── HTTP Request node security ────────────────────────────────────────
# Comma-separated host allowlist; empty = all http/https hosts allowed.
# HTTP_ALLOWED_HOSTS=api.example.com,jsonplaceholder.typicode.com

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./jevstudio.db
